# === Kebab House — Environment Variables ===
# Copia questo file in `.env` e inserisci i valori reali.
# Il file `.env` NON viene mai committato (vedi .gitignore).

# URL pubblico del sito (usato per metadata SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://kebab-house.vercel.app

# kie.ai — generazione immagini AI dei piatti (Nano Banana)
# Ottieni la chiave su https://kie.ai  → Dashboard → API Keys
KIE_API_KEY=
